
@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- Hiển thị thông báo nếu có -->
@if (TempData["Success"] != null)
{
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
        <div class="toast align-items-center text-bg-success border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <span class="icon">✔</span> @TempData["Success"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}



<section class="main-banner">
    <div class="container">
        <section class="slider-banner">
            <div class="container my-4">
                <div id="carouselBanner" class="carousel slide" data-bs-ride="carousel">
                    <!-- Indicators -->
                    <div class="carousel-indicators">
                        <button type="button" data-bs-target="#carouselBanner" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                        <button type="button" data-bs-target="#carouselBanner" data-bs-slide-to="1" aria-label="Slide 2"></button>
                        <button type="button" data-bs-target="#carouselBanner" data-bs-slide-to="2" aria-label="Slide 3"></button>
                    </div>

                    <!-- Slides -->
                    <div class="carousel-inner rounded">
                        <div class="carousel-item active">
                            <img src="~/img/banner/1.jpg" class="d-block w-100" alt="Khuyến mãi Xuân 2025">

                        </div>
                        <div class="carousel-item">
                            <img src="~/img/banner/2.jpg" class="d-block w-100" alt="Laptop giảm giá">

                        </div>
                        <div class="carousel-item">
                            <img src="~/img/banner/4.jpg" class="d-block w-100" alt="Phụ kiện hàng hiệu">

                        </div>
                    </div>

                    <!-- Controls -->
                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselBanner" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselBanner" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
        </section>

    </div>
</section>

<section class="product-display">
    <div class="container">
        <div class="products-grid">
            @foreach (var product in Model)
            {
                <div class="product-card">
                    <a href="@Url.Action("ChiTiet", "Module", new { loaiAlias = product.LoaiSanPham.Link, alias = product.Link })" class="product-link">
                        <div class="product-img-container">
                            <img src="@Url.Content("~/img/sanpham/" + product.HinhAnh)" alt="@product.TenSP">
                        </div>
                        <h3 class="product-name">@product.TenSP</h3>
                        <div class="product-price">
                            <span class="current-price">
                                @if (product.GiaDau > 0 && product.SoGiam >= 0)
                                {
                                    var giaBan = product.GiaDau - (product.GiaDau * product.SoGiam / 100);
                                    @String.Format("{0:N0} VND", giaBan)
                                }
                            </span>
                            <div class="price-info">
                                <span class="old-price">@(product.GiaDau?.ToString("#,##0") ?? "0") VNĐ</span>
                                <span class="discount">-@product.SoGiam%</span>
                            </div>
                        </div>
                    </a>
                </div>

            }
        </div>

    </div>

</section>  
<style>
    .icon {
        font-weight: bold;
        font-size: 18px;
    }
</style>
