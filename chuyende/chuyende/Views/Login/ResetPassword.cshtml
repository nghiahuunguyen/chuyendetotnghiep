@{
    ViewBag.Title = "Xác nhận OTP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- 🔔 Toast báo lỗi (nếu có) -->
@if (ViewBag.ErrorMessage != null)
{
    <div class="toast-error" id="toast-error">
        <span>@ViewBag.ErrorMessage</span>
        <span class="toast-close" onclick="this.parentElement.remove()">×</span>
    </div>
}


<!-- 🧾 Giao diện nhập OTP -->
<div class="otp-container">
    <h2>Xác thực tài khoản</h2>
    <p>Mã OTP đã được gửi đến email: <strong>@ViewBag.Email</strong></p>

    <form method="post">
        <input type="hidden" name="email" value="@ViewBag.Email" />
        <input type="text" name="otp" placeholder="Nhập mã OTP" class="otp-input" required />
        <button type="submit" class="confirm-btn">Xác nhận</button>
    </form>
</div>

<!-- 🎨 Style -->
<style>
    .toast-error {
        position: fixed;
        top: 20px;
        right: 20px;
        background-color: #dc3545;
        color: white;
        padding: 10px 15px;
        border-radius: 6px;
        font-size: 14px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .toast-close {
        margin-left: 10px;
        cursor: pointer;
        font-weight: bold;
    }

    .otp-container {
        max-width: 400px;
        margin: 100px auto;
        padding: 30px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        text-align: center;
    }

        .otp-container h2 {
            margin-bottom: 15px;
        }

    .otp-input {
        width: 100%;
        padding: 12px;
        font-size: 16px;
        margin: 20px 0;
        border: 1px solid #ccc;
        border-radius: 8px;
    }

    .confirm-btn {
        width: 100%;
        padding: 12px;
        background-color: #007bff;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

        .confirm-btn:hover {
            background-color: #0056b3;
        }
</style>
