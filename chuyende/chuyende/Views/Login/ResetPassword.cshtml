@{
    ViewBag.Title = "Xác nhận OTP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- 🔔 Toast báo lỗi hoặc thông báo -->
@if (ViewBag.ErrorMessage != null)
{
    <div class="toast-error" id="toast-error">
        <span class="icon">✖</span>
        <span>@ViewBag.ErrorMessage</span>
        <span class="toast-close" onclick="this.parentElement.remove()">×</span>
    </div>
}

<!-- 🧾 Giao diện nhập OTP -->
<div class="otp-container">
    <h2>Xác thực tài khoản</h2>
    <p>Mã OTP đã được gửi đến email: <strong>@ViewBag.Email</strong></p>
    <!-- Bộ đếm thời gian OTP -->
    <p id="otpTimer" style="color: #dc3545;">Thời gian OTP còn lại: <span id="otpCountdown">02:00</span></p>

    <!-- Form nhập OTP -->
    <form method="post" action="@Url.Action("ResetPassword", "Login")" id="otpForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="email" value="@ViewBag.Email" />
        <input type="text" name="otp" placeholder="Nhập mã OTP" class="otp-input" required />
        <button type="submit" class="confirm-btn">Xác nhận</button>
    </form>

    <!-- Form gửi lại OTP (liên kết văn bản) -->
    <form method="post" action="@Url.Action("ResendOTP", "Login")" id="resendForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="email" value="@ViewBag.Email" />
        <a href="javascript:void(0);" id="resendLink" class="resend-link" onclick="document.getElementById('resendForm').submit();" style="display: none;">Gửi lại mã OTP</a>
    </form>
    <!-- Bộ đếm thời gian chờ gửi lại OTP -->
    <p id="cooldownTimer" style="color: #dc3545;">Vui lòng đợi 30 giây để gửi lại mã</p>
</div>

<!-- 🎨 JavaScript xử lý bộ đếm giờ -->
<script>
    // --- Bộ đếm thời gian hết hạn OTP (2 phút = 120 giây) ---
    let otpSeconds = 120; // OTP hết hạn sau 120 giây
    const otpCountdown = document.getElementById('otpCountdown');
    let otpInterval;

    function updateOtpTimer() {
        const minutes = Math.floor(otpSeconds / 60);
        const seconds = otpSeconds % 60;
        otpCountdown.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
        if (otpSeconds <= 0) {
            otpCountdown.textContent = 'Hết hạn';
            otpCountdown.style.color = '#dc3545';
            clearInterval(otpInterval);
        }
        otpSeconds--;
    }

    function startOtpTimer() {
        otpSeconds = 120; // Reset về 2 phút
        clearInterval(otpInterval);
        updateOtpTimer();
        otpInterval = setInterval(updateOtpTimer, 1000);
    }

    // Bắt đầu bộ đếm OTP
    startOtpTimer();

    // --- Bộ đếm thời gian chờ gửi lại OTP (30 giây) ---
    let cooldownSeconds = 30; // Mặc định 30 giây khi tải trang
    const resendLink = document.getElementById('resendLink');
    const cooldownTimer = document.getElementById('cooldownTimer');
    let cooldownInterval; // Khai báo biến cooldownInterval

    // Kiểm tra thông báo từ server
    const message = '@ViewBag.ErrorMessage';
    if (message.includes('Vui lòng đợi')) {
        const match = message.match(/(\d+)/);
        if (match) {
            cooldownSeconds = parseInt(match[0]);
        }
    } else if (message.includes('Mã OTP mới đã được gửi')) {
        cooldownSeconds = 30; // Reset thời gian chờ khi gửi lại thành công
    }

    function updateCooldownTimer() {
        if (cooldownSeconds > 0) {
            cooldownTimer.textContent = `Vui lòng đợi ${cooldownSeconds} giây để gửi lại mã`;
            resendLink.style.display = 'none';
        } else {
            cooldownTimer.textContent = '';
            resendLink.style.display = 'inline';
            clearInterval(cooldownInterval);
        }
        cooldownSeconds--;
    }

    function startCooldownTimer(seconds) {
        cooldownSeconds = seconds;
        clearInterval(cooldownInterval);
        updateCooldownTimer();
        cooldownInterval = setInterval(updateCooldownTimer, 1000);
    }

    // Bắt đầu bộ đếm thời gian chờ
    startCooldownTimer(cooldownSeconds);

    // Reset bộ đếm OTP khi gửi lại OTP thành công
    if (message.includes('Mã OTP mới đã được gửi')) {
        startOtpTimer(); // Reset bộ đếm OTP về 2 phút
    }

    // Debug: Kiểm tra token chống giả mạo
    document.getElementById('otpForm').addEventListener('submit', function (e) {
        const token = this.querySelector('input[name="__RequestVerificationToken"]');
        if (!token) {
            console.error('Anti-forgery token not found in otpForm');
        } else {
            console.log('Anti-forgery token found in otpForm:', token.value);
        }
    });

    document.getElementById('resendForm').addEventListener('submit', function (e) {
        const token = this.querySelector('input[name="__RequestVerificationToken"]');
        if (!token) {
            console.error('Anti-forgery token not found in resendForm');
        } else {
            console.log('Anti-forgery token found in resendForm:', token.value);
        }
    });
</script>

<!-- 🎨 Style -->
<style>
    .icon {
        font-weight: bold;
        font-size: 18px;
    }

    .toast-error {
        position: fixed;
        top: 20px;
        right: 20px;
        background-color: #dc3545;
        color: white;
        padding: 10px 15px;
        border-radius: 6px;
        font-size: 14px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .toast-close {
        margin-left: 10px;
        cursor: pointer;
        font-weight: bold;
    }

    .otp-container {
        max-width: 400px;
        margin: 100px auto;
        padding: 30px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        text-align: center;
    }

        .otp-container h2 {
            margin-bottom: 15px;
        }

    .otp-input {
        width: 100%;
        padding: 12px;
        font-size: 16px;
        margin: 20px 0;
        border: 1px solid #ccc;
        border-radius: 8px;
    }

    .confirm-btn {
        width: 100%;
        padding: 12px;
        background-color: #42A5F5;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

        .confirm-btn:hover {
            background-color: #2196F3;
        }

    /* Định dạng liên kết gửi lại OTP */
    .resend-link {
        color: #42A5F5;
        font-size: 14px;
        text-decoration: underline;
        cursor: pointer;
    }

        .resend-link:hover {
            color: #2196F3;
        }

    /* Định dạng bộ đếm thời gian */
    #otpTimer, #cooldownTimer {
        font-size: 14px;
        margin: 10px 0;
    }

    #otpCountdown {
        font-weight: bold;
    }
</style>