
@model IEnumerable<chuyende.Models.LoaiBaiViet>

<div class="footer-content">
    @foreach (var loai in Model)
    {
        <div class="footer-column">
            <h3 class="footer-title">@loai.TenLoaiBV</h3>
            <ul class="footer-links">
                @foreach (var baiViet in loai.BaiViets.Where(bv => bv.Status == 1))
                {
                    <li>
                        <a href="@Url.Action("Article", "Home", new { link = baiViet.Link })">@baiViet.TenBV</a>
                    </li>
                }
            </ul>
        </div>
    }
</div>
