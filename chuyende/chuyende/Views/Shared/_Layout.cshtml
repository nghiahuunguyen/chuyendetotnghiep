<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="icon" type="image/png" href="~/img/logo/logo.png">
    <link rel="stylesheet" href="~/Public/css/Use/_layout.css">
    <link rel="stylesheet" href="~/Public/css/Use/nhapky.css">
    <link rel="stylesheet" href="~/Public/css/Use/xacnhanmk.css">
    <link rel="stylesheet" href="~/Public/css/Use/user.css">
    <link rel="stylesheet" href="~/Public/css/Use/sanpham.css">
    <link rel="stylesheet" href="~/Public/css/Use/chitietsp.css">
    <link rel="stylesheet" href="~/Public/css/Use/cart.css">
    <link rel="stylesheet" href="~/Public/css/Use/goiy.css">
    <link rel="stylesheet" href="~/Public/css/Admin/hoadonadmin.css">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>

    <header class="top-header">
        <div class="container">
            <!-- Logo -->

            <a href="@Url.Action("Index","Home")" class="logo">
                <img src="~/img/logo/logo.png" alt="" class="logo-img">
                <h3 class="logo-text">ELECTRONICS STORE</h3>
            </a>

            <!-- Search bar -->
            <form class="search-container" method="get" action="/Search/Index">
                <input type="text" id="search-input" name="query" class="search-input" placeholder="Bạn tìm gì..." autocomplete="off" />
                <div id="suggestions" class="suggestion-box"></div>
                <button type="submit" class="search-button">
                    <i class="fas fa-search"></i>
                </button>
            </form>


            <!-- User tools -->
            <div class="user-tools">
                @if (Session["User"] == null)
                {
                    <!-- Nếu chưa đăng nhập, hiển thị nút đăng nhập -->
                    <a href="@Url.Action("Index", "Login")" class="tool-item">
                        <i class="fas fa-user"></i>
                        <span>Đăng nhập</span>
                    </a>
                }
                else
                {
                    var user = (chuyende.Models.KhachHang)Session["User"];


                    <a href="@Url.Action("Index", "User")" class="tool-item">
                        <i class="fas fa-user"></i>
                        <span>@user.TenKH</span>

                    </a>

                }

                <a href="@Url.Action("Index","Cart")" class="tool-item position-relative">
                    <i class="fas fa-shopping-cart"></i>
                    <span>Giỏ hàng</span>

                </a>


            </div>
        </div>
    </header>

    <!-- Main navigation menu -->
    @Html.Action("Menu", "Module")




    <!-- Main Content -->
    <div class="main-content">
        @RenderBody()
    </div>
    <!-- Footer section -->
    <footer class="main-footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-column">
                    <h3 class="footer-title">Hỗ trợ khách hàng</h3>
                    <ul class="footer-links">
                        <li><a href="/hotline">Gọi mua hàng: 0366 541 719 (7:30 - 22:00)</a></li>
                        <li><a href="/bao-hanh">Bảo hành: 0366 541 718 (8:00 - 21:00)</a></li>
                    </ul>
                </div>

                <div class="footer-column">
                    <h3 class="footer-title">Thông tin công ty</h3>
                    <ul class="footer-links">
                        <li><a href="/about">Giới thiệu công ty</a></li>
                        <li><a href="/careers">Tuyển dụng</a></li>
                        <li><a href="/terms">Điều khoản sử dụng</a></li>
                        <li><a href="/privacy">Chính sách bảo mật</a></li>
                    </ul>
                </div>

                     

                <div class="footer-column">
                    <h3 class="footer-title">Kết nối với chúng tôi</h3>
                    <div class="social-links">
                        <a href="https://www.facebook.com/nguyenhuunghia1607" class="social-link"><i class="fab fa-facebook-f"></i></a>
                        <a href="https://www.instagram.com/nguyenhuunghia1607/" class="social-link"><i class="fab fa-instagram"></i></a>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <p class="copyright">CỬA HÀNG BÁN ĐỒ ĐIỆN TỬ ELECTRONICS STORE.</p>
                <p class="address">Địa chỉ: Diên Lạc, Diên Khánh, Khánh Hòa. Điện thoại: 0366 541 719</p>
            </div>
        </div>
    </footer>
    <script>
        $(document).ready(function () {
            $(".dropdown-toggle").click(function (e) {
                e.preventDefault(); // Ngăn chặn reload trang
                $(this).next(".dropdown-menu").toggle();
            });
        });
    </script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#search-input').keyup(function () {
                var query = $(this).val();
                if (query.length >= 2) {
                    $.ajax({
                        url: '/Search/Suggest',
                        type: 'GET',
                        data: { term: query },
                        success: function (data) {
                            var suggestionBox = $('#suggestions');
                            suggestionBox.empty();

                            if (data.length > 0) {
                                data.forEach(function (item) {
                                    suggestionBox.append('<div>' + item.label + '</div>');
                                });

                                // Gắn sự kiện khi click vào gợi ý
                                suggestionBox.find('div').on('click', function () {
                                    $('#search-input').val($(this).text());
                                    suggestionBox.empty();
                                });
                            } else {
                                suggestionBox.empty();
                            }
                        }
                    });
                } else {
                    $('#suggestions').empty();
                }
            });
        });
    </script>

</body>
</html>