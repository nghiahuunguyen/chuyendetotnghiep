@model List<chuyende.Models.ChiTietGioHang>
@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var tongTien = ViewBag.TongTien ?? 0;
}
@if (TempData["Message"] != null)
{
    <div class="alert alert-info">
        <span class="icon">✖</span>
        @TempData["Message"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="toast-error" id="toast-error">
        <span class="icon">✖</span>
        <span>@TempData["ErrorMessage"]</span>
        <span class="toast-close" onclick="this.parentElement.remove()">×</span>
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 400px; background-color: #f8f9fa;">
        <div class="text-center bg-white p-4 rounded shadow" style="max-width: 500px;">
            <img src="~/img/giohang/empty-cart.png" alt="Empty Cart" class="img-fluid mb-3" />
            <h4 class="text-dark mb-2">Giỏ hàng trống</h4>
            <p class="text-muted mb-4">Không có sản phẩm nào trong giỏ hàng</p>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary">Về trang chủ</a>
        </div>
    </div>
}
else
{
    <div class="container py-5">
        <div class="row">
            <div class="col-lg-8">
                <h4 class="mb-4">Giỏ hàng của bạn (@Model.Count sản phẩm)</h4>

                @foreach (var item in Model)
                {
                    var sp = item.SanPham;
                    var giaGoc = sp.GiaDau ?? 0;
                    var soGiam = sp.SoGiam ?? 0;
                    var donGia = giaGoc - (giaGoc * soGiam / 100);
                    var thanhTien = donGia * item.SoLuong;

                    <div class="border-bottom py-3 d-flex flex-wrap align-items-center">
                        <div class="col-md-3 text-center mb-3 mb-md-0">
                            <img src="~/img/sanpham/@sp.HinhAnh" alt="@sp.TenSP" class="img-fluid rounded shadow-sm" style="max-height: 120px;" />
                        </div>

                        <div class="col-md-6 px-3">
                            <h6 class="fw-bold">@sp.TenSP</h6>
                            <div>
                                <span class="text-danger fw-bold">@String.Format("{0:N0} đ", donGia)</span>
                                @if (giaGoc > donGia)
                                {
                                    <small class="text-muted text-decoration-line-through ms-2">@String.Format("{0:N0} đ", giaGoc)</small>
                                }
                            </div>
                            @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post, new { @class = "d-flex align-items-center mt-2" }))
                            {
                                <input type="hidden" name="id" value="@sp.MaSP" />

                                <button type="submit" name="action" value="decrease" class="btn btn-sm btn-outline-secondary"
                                        @(item.SoLuong <= 1 ? "disabled" : "")>
                                    -
                                </button>

                                <input type="text" readonly class="form-control form-control-sm mx-2 text-center" value="@item.SoLuong" style="width: 50px;" />

                                <button type="submit" name="action" value="increase" class="btn btn-sm btn-outline-secondary">+</button>
                            }


                        </div>

                        <div class="col-md-3 text-end">
                            <div class="text-danger fw-bold mb-2">@String.Format("{0:N0} đ", thanhTien)</div>
                            <a href="@Url.Action("RemoveFromCart", "Cart", new { id = sp.MaSP })" class="btn btn-sm btn-danger">Xoá</a>
                        </div>
                    </div>
                }
            </div>

            <div class="col-lg-4">
                <div class="border p-4 rounded shadow-sm bg-light">
                    <h5 class="mb-3">Tóm tắt đơn hàng</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tạm tính (@Model.Count sản phẩm)</span>
                        <span>@String.Format("{0:N0} đ", tongTien)</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Phí vận chuyển</span>
                        <span>Miễn phí</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between fw-bold mb-3">
                        <span>Tổng cộng</span>
                        <span>@String.Format("{0:N0} đ", tongTien)</span>
                    </div>
                    <a href="@Url.Action("Checkout", "Cart")" class="btn btn-primary w-100 mb-2">
                        Tiến hành thanh toán
                    </a>

                    <a href="@Url.Action("Index", "Home")" class="text-decoration-none text-center d-block">Tiếp tục mua sắm</a>
                    <a href="@Url.Action("ClearCart", "Cart")" class="text-danger small d-block mt-2 text-center">Xoá toàn bộ giỏ hàng</a>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .icon {
        font-weight: bold;
        font-size: 18px;
    }
    .toast-error {
        position: fixed;
        top: 60px;
        right: 20px;
        background-color: #dc3545; /* đỏ Bootstrap */
        color: white;
        padding: 10px 15px;
        border-radius: 6px;
        font-size: 14px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .toast-success {
        position: fixed;
        top: 20px;
        right: 20px;
        background-color: #28a745;
        color: white;
        padding: 10px 15px;
        border-radius: 6px;
        font-size: 14px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .toast-close {
        margin-left: 10px;
        cursor: pointer;
        font-weight: bold;
    }
</style>