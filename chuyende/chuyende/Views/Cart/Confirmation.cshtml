@model chuyende.Models.HoaDon

@{
    ViewBag.Title = "Tạo hóa đơn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (!ViewData.ModelState.IsValid)
{
    <div style="color:red;">
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <span class="icon">✖</span>
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

@using (Html.BeginForm("CompletePayment", "Cart", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="main-content">
        <div class="form-container">
            <div class="customer-info">
                <h3>Thông tin khách hàng</h3>

                <div class="form-group">
                    <label>Họ và tên</label>
                    <span class="form-control">@Model.TenKH</span>
                </div>

                <div class="form-group">
                    <label>Địa chỉ</label>
                    <span class="form-control">@Model.DiaChi</span>
                </div>
                <div class="form-group">
                    <label>Email</label>
                    <span class="form-control">@Model.Email</span>
                </div>
                <div class="form-group">
                    <label>Số điện thoại</label>
                    <span class="form-control">@Model.SoDienThoai</span>
                </div>
                <div class="form-group">
                    <label>Ngày mua</label>
                    <span class="form-control">@String.Format("{0:dd/MM/yyyy}", Model.NgayTao)</span>
                </div>
            </div>

            <div class="order-info">
                <h3>Thông tin đơn hàng</h3>
                <div class="table-container">
                    <table id="orderTable">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Số lượng</th>
                                <th>Đơn giá</th>
                                <th>Thành Tiền</th>
                            </tr>
                        </thead>
                        <tbody id="orderProducts">
                            @foreach (var item in Model.ChiTietHoaDon)
                            {
                                <tr>
                                    <td>@item.SanPham.TenSP</td>
                                    <td>@item.SoLuong</td>
                                    <td>@item.SanPham.GiaDau</td>
                                    <td>@(item.SanPham.GiaDau * item.SoLuong)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="form-group">
                    <label>Tổng tiền</label>
                    <span class="form-control">@string.Format("{0:N0} đ", ViewBag.TotalAmount)</span>
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.PhuongThucThanhToan, "Phương thức thanh toán")
                    @Html.DropDownListFor(m => m.PhuongThucThanhToan, new SelectList(new[] {
                        new { Value = 3, Text = "Thanh toán sau khi nhận hàng" },
                        new { Value = 2, Text = "Chuyển khoản " }
                    }, "Value", "Text"), new { @class = "form-control" })
                </div>

                <button class="payment-btn" type="submit">Thanh toán</button>
            </div>
        </div>
    </div>
}


<!-- Thêm jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Thêm Select2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<!-- Thêm Select2 JS -->
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<style>
    .form-container {
        display: flex;
        width: 100%;
        background: white;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
        border-radius: 8px;
    }
    .icon {
        font-weight: bold;
        font-size: 18px;
    }
    .customer-info, .order-info {
        flex: 1;
        padding: 20px;
    }

        .customer-info h3, .order-info h3 {
            margin-bottom: 15px;
            border-bottom: 2px solid #007bff;
            padding-bottom: 10px;
        }

    .form-group {
        margin-top: 10px;
        margin-bottom: 15px;
    }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            color: #333;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            padding: 8px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }
</style>

