@model chuyende.Models.HoaDon
@{
    ViewBag.Title = "Đơn hàng đã mua";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="account-container">

    <div class="account-sidebar">
        <div> @((Session["User"] as chuyende.Models.KhachHang)?.TenKH) </div>
        <a href="@Url.Action("Index", "User")" class="account-sidebar-item active">
            <i class="fas fa-address-book"></i>
            Thông tin tài khoản
        </a>

        <a href="@Url.Action("ViewOrder", "User")" class="account-sidebar-item active">
            <i class="fas fa-shopping-bag"></i>
            Đơn hàng đã mua
        </a>

        <a href="@Url.Action("Logout", "User")" class="logout">
            <button class="account-sidebar-logout">Đăng Xuất</button>
        </a>

    </div>

    <div class="main-content">
        <div class="personal-info">
            <h2>
                CHI TIẾT ĐƠN HÀNG - @Model.MaHD -@{
                    string tt = "";
                    string color = "";
                    switch (Model.TrangThai)
                    {
                        case 0:
                            tt = "Đã thanh toán";
                            color = "green";
                            break;
                        case 1:
                            tt = "Đang xử lý";
                            color = "red";
                            break;
                        case 2:
                            tt = "Đang vận chuyển";
                            color = "red";
                            break;
                        case 3:
                            tt = "Đã giao và thanh toán";
                            color = "green";
                            break;
                        default:
                            tt = "Không xác định";
                            color = "black";
                            break;
                    }
                }
                <span style="color: @color; font-weight: bold;">@tt</span>

            </h2>
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Hình ảnh</th>
                        <th>Đơn giá</th>
                        <th>Số lượng</th>
                        <th>Giảm</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ct in Model.ChiTietHoaDon)
                    {
                        <tr>
                            <td>@ct.SanPham.TenSP</td>
                            <td>
                                <img src="@Url.Content("~/img/sanpham/" + ct.SanPham.HinhAnh)" alt="@ct.SanPham.TenSP" width="80" />
                            </td>
                            <td>@String.Format("{0:C0}", ct.SanPham.GiaDau)</td>
                            <td>@ct.SoLuong</td>
                            <td>@String.Format("{0:C0}", ct.SanPham.SoGiam)</td>
                            <td>
                                @String.Format("{0:C0}", ct.SoLuong * (ct.SanPham.GiaDau - ct.SanPham.SoGiam))
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="5" class="text-end">Tổng cộng:</th>
                        <th>
                            @String.Format("{0:C0}", Model.ChiTietHoaDon.Sum(c => c.SoLuong * (c.SanPham.GiaDau - c.SanPham.SoGiam)))
                        </th>
                    </tr>
                </tfoot>
            </table>


            <div class="text-center mt-4">
                <a href="@Url.Action("ViewOrder", "User")" class="btn btn-primary" style="background-color: #2f80ed; border-color: #007BFF;">
                    Về trang danh sách hóa đơn
                </a>
            </div>

        </div>

    </div>
</div>
