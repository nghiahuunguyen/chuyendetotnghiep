@model IEnumerable<chuyende.Models.SanPham>
@{
    ViewBag.Title = ViewBag.TenLoaiSP;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="product-display">
    <div class="container">
        <!-- Hiển thị logo của các hãng liên quan đến loại sản phẩm -->
        <div class="brand-logos">
            @foreach (var hang in ViewBag.HangSanPhams)
            {
                <div class="brand-logo-container">
                    @if (hang != null && hang.Logo != null)
                    {
                        <a href="@Url.Action("ByHang", "Module", new { loaiAlias = Request.Url.Segments[1].Trim('/'), hangAlias = hang.MaHang })">
                            <img src="@Url.Content("~/img/hang/" + hang.Logo)" alt="@hang.TenHang" class="brand-logo">
                        </a>
                    }
                </div>
            }
        </div>
        <!-- Products grid -->
        <div class="products-grid">
            <!-- Lặp qua từng sản phẩm -->
            @foreach (var product in Model)
            {
                <div class="product-card">
                    <a href="@Url.Action("ChiTiet", "Module", new { loaiAlias = product.LoaiSanPham.Link, alias = product.Link })" class="product-link">

                        <div class="product-img-container">
                            <img src="@Url.Content("~/img/sanpham/" + product.HinhAnh)" alt="@product.TenSP">
                        </div>
                        <h3 class="product-name">@product.TenSP</h3>
                        <div class="product-price">
                            <span class="current-price">
                                @if (product.GiaDau > 0 && product.SoGiam >= 0)
                                {
                                    var giaBan = product.GiaDau - (product.GiaDau * product.SoGiam / 100);
                                    @String.Format("{0:N0} VND", giaBan)
                                }
                            </span>
                            <div class="price-info">
                                <span class="old-price">@(product.GiaDau?.ToString("#,##0") ?? "0") VNĐ</span>
                                <span class="discount">-@product.SoGiam%</span>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<style>
    /* CSS cho phần logo của các hãng */
    .brand-logos {
        display: flex;
        flex-wrap: nowrap; /* Đảm bảo không bị xuống dòng */
        justify-content: center; /* Canh giữa các logo */
        gap: 20px; /* Khoảng cách giữa các logo */
        margin-bottom: 20px; /* Khoảng cách dưới các logo */
    }

    .brand-logo-container {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 80px; /* Tăng chiều rộng container logo */
        height: 80px; /* Tăng chiều cao container logo */
    }

    .brand-logo {
        width: 100%; /* Đảm bảo logo chiếm hết chiều rộng của container */
        height: 100%; /* Đảm bảo logo chiếm hết chiều cao của container */
        object-fit: contain; /* Đảm bảo ảnh không bị biến dạng và vẫn giữ được tỷ lệ */
        transition: transform 0.3s ease; /* Thêm hiệu ứng zoom khi hover */
    }

        .brand-logo:hover {
            transform: scale(1.1); /* Zoom khi hover */
        }

</style>