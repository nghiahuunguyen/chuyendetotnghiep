<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="~/Public/css/Admin/layoutadmin.css">
    <link rel="stylesheet" href="~/Public/css/Admin/admin.css">
    <link rel="stylesheet" href="~/Public/css/Admin/Detailssp.css">
    <link rel="stylesheet" href="~/Public/css/Admin/phantrang.css">
    <link rel="stylesheet" href="~/Public/css/Admin/hoadonadmin.css">
    <link rel="stylesheet" href="~/Public/css/Admin/thongbao.css">
    <link rel="stylesheet" href="~/Public/css/Use/load.css">
    <title>@ViewBag.Title</title>
    <link rel="icon" type="image/png" href="~/img/logo/logo.png">
    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
</head>
@{
    var maChucVu = (Session["MaChucVu"] ?? "").ToString().Trim().ToLower();
    var tenChucVu = (Session["TenChucVu"] ?? "").ToString();
}

<body>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <div id="loader">
        <img src="~/img/logo/logo.png" alt="Logo"> <!-- Thay logo.png bằng đường dẫn logo của bạn -->
    </div>
    <!-- Sidebar -->
    <div class="sidebar">
        <h3>ELECTRONICS STORE</h3>

        <div class="profile">
            @if (ViewBag.MaNV != null)
            {
                <a href="@Url.Action("DoiMatKhau", "HomeAdmin", new { id = ViewBag.MaNV })" class="profile-link">
                    <h4>@Session["Admin"]</h4>
                    <p>Chức vụ: @tenChucVu</p>
                </a>
            }
            else
            {
                <div class="profile-link">
                    <h4>@Session["Admin"]</h4>
                    <p>Chức vụ: @tenChucVu</p>
                    
                </div>
            }
        </div>

        @{
            var currentController = Request.RequestContext.RouteData.Values["controller"].ToString();
        }
        <ul>
            <li class="@(currentController == "HomeAdmin" ? "active" : "")">
                <a href="@Url.Action("Index", "HomeAdmin", new { area = "Admin" })">
                    <i class="fas fa-home"></i> Trang chủ
                </a>
            </li>

            <li>
                <a href="@Url.Action("Index", "Home", new { area = "" })">
                    <i class="fas fa-chart-line"></i> Trang bán hàng
                </a>
            </li>

            @if (maChucVu == "ql")
            {
                <li class="has-submenu @(new[] { "NhanViens", "ChucVus" }.Contains(currentController) ? "active" : "")">
                    <div class="menu-item">
                        <span><i class="fas fa-users"></i> Nhân sự</span>
                        <i class="fas fa-chevron-right arrow"></i>
                    </div>
                    <ul class="submenu">
                        <li class="@(currentController == "NhanViens" ? "active" : "")">
                            <a href="@Url.Action("Index", "NhanViens")"><i class="fas fa-user"></i> Nhân Viên</a>
                        </li>
                        <li class="@(currentController == "ChucVus" ? "active" : "")">
                            <a href="@Url.Action("Index", "ChucVus")"><i class="fas fa-user-shield"></i> Chức vụ</a>
                        </li>
                    </ul>
                </li>

                <li class="@(currentController == "Hangs" ? "active" : "")">
                    <a href="@Url.Action("Index", "Hangs")">
                        <i class="fas fa-truck"></i> Hãng
                    </a>
                </li>
            }

            @if (new[] { "ql", "nv", "kt", "tk" }.Contains(maChucVu))
            {
                <li class="has-submenu @(new[] { "LoaiSanPhams", "SanPhams" }.Contains(currentController) ? "active" : "")">
                    <div class="menu-item">
                        <span><i class="fas fa-box"></i> Sản phẩm</span>
                        <i class="fas fa-chevron-right arrow"></i>
                    </div>
                    <ul class="submenu">
                        <li class="@(currentController == "LoaiSanPhams" ? "active" : "")">
                            <a href="@Url.Action("Index", "LoaiSanPhams")"><i class="fas fa-tags"></i> Loại sản phẩm</a>
                        </li>
                        <li class="@(currentController == "SanPhams" ? "active" : "")">
                            <a href="@Url.Action("Index", "SanPhams")"><i class="fas fa-box"></i> Sản phẩm</a>
                        </li>
                    </ul>
                </li>

                <li class="@(currentController == "KhachHangs" ? "active" : "")">
                    <a href="@Url.Action("Index", "KhachHangs")">
                        <i class="fas fa-user"></i> Khách hàng
                    </a>
                </li>

                <li class="@(currentController == "HoaDons" ? "active" : "")">
                    <a href="@Url.Action("Index", "HoaDons")">
                        <i class="fas fa-file-invoice"></i> Đơn hàng
                    </a>
                </li>

                <li class="@(currentController == "LienHes" ? "active" : "")">
                    <a href="@Url.Action("Index", "LienHes")">
                        <i class="fas fa-envelope"></i> Liên hệ
                    </a>
                </li>
            }

            @if (new[] { "ql", "kt", "tk" }.Contains(maChucVu))
            {
                <li class="@(currentController == "ThongKe" ? "active" : "")">
                    <a href="@Url.Action("Index", "ThongKe")">
                        <i class="fas fa-chart-bar"></i> Thống kê
                    </a>
                </li>
            }
        </ul>



        <a href="@Url.Action("Logout", "DangNhap", new { area = "Admin" })" class="logout">
            <i class="fas fa-sign-out-alt"></i> Đăng xuất
        </a>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        @RenderBody()
    </div>

    <!-- Render the Scripts section -->
    @RenderSection("Scripts", required: false)
    <script>
        window.addEventListener("load", function () {
            setTimeout(function () {
                const loader = document.getElementById("loader");
                loader.classList.add("fade-out");
                setTimeout(() => {
                    loader.style.display = "none";
                    document.getElementById("main-content").style.display = "block";
                }, 1000); // chờ hiệu ứng fade-out
            }, 800); //
        });
    </script>
</body>
</html>