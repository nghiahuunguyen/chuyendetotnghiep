@model chuyende.Models.LienHe

@{
    ViewBag.Title = "Xem chi tiết chức vụ";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="table-container">
    <h3>Xem chi tiết liên hệ</h3>

    <table>
        <thead>
            <tr>
                <th>Tên khách hàng</th>
                <th>Tiêu đề</th>
                <th>Nội dung</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@Html.DisplayFor(model => model.HoTen)</td>
                <td>@Html.DisplayFor(model => model.TieuDe)</td>
                <td>@Html.DisplayFor(model => model.NoiDung)</td>
            </tr>
        </tbody>
    </table>
    <div class="form-actions">
        <button type="button" class="cancel-btn btn btn-secondary" onclick="window.location.href='@Url.Action("Index", "LienHes")'">Hủy</button>

    </div>
</div>