<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trang đăng nhập</title>
    <link rel="icon" type="image/png" href="~/img/logo/logo.png">
    <link rel="stylesheet" href="~/Public/css/Admin/dangnhap.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>



    <div class="login-container">
        <img src="~/img/logo/logo.png" alt="" class="logo-img" style="height: 130px; width: auto;">
        <h3 class="logo-text">ELECTRONICS STORE</h3>
        <h2 class="login-title">Đăng nhập quản lý</h2>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert-box error" id="error-alert">
                <span class="icon">✖</span>
                <span>@TempData["ErrorMessage"]</span>
                <button class="close-btn" onclick="this.parentElement.style.display='none';">×</button>
            </div>
        }


        <form id="loginForm" method="post" action="@Url.Action("Index", "DangNhap", new { area = "Admin" })">
            <div class="input-group">
                <i class="fas fa-user"></i>
                <input type="text" name="TenDN" class="form-control" placeholder="Tên đăng nhập">
            </div>



            <div class="password-wrapper">
                <input type="password" id="password" name="MatKhau" class="form-control" placeholder="Mật khẩu">
                <i class="fas fa-eye" id="toggleIcon" onclick="togglePassword()"></i>
            </div>



            <button type="submit" class="login-button">Đăng nhập</button>
        </form>
    </div>
    <style>
        .alert-box {
            position: fixed;
            top: 20px;
            right: 20px;
            min-width: 250px;
            padding: 12px 18px;
            border-radius: 8px;
            color: white;
            font-size: 16px;
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            z-index: 9999;
        }

            .alert-box.success {
                background-color: #26ca26; /* Light green tone */
                color: #fbfefb; /* Đậm hơn cho chữ dễ đọc */
            }

            .alert-box.error {
                background-color: #dc3545;
            }

            .alert-box .icon {
                font-weight: bold;
                font-size: 18px;
            }

            .alert-box .close-btn {
                background: none;
                border: none;
                color: white;
                font-size: 20px;
                font-weight: bold;
                cursor: pointer;
                margin-left: auto;
            }

                .alert-box .close-btn:hover {
                    color: #ddd;
                }

        .password-wrapper {
            position: relative;
            width: 100%;
        }

            .password-wrapper .form-control {
                width: 100%;
                padding-right: 40px; /* chừa chỗ cho icon */
                box-sizing: border-box;
            }

            .password-wrapper i {
                position: absolute;
                top: 50%;
                right: 12px;
                transform: translateY(-50%);
                cursor: pointer;
                color: #666;
                font-size: 16px;
            }

        .login-button {
            margin-top: 15px; /* hoặc 20px tùy bạn thích */
        }


    </style>
    <script>
        function togglePassword() {
            const passwordInput = document.getElementById("password");
            const icon = document.getElementById("toggleIcon");
            const isPassword = passwordInput.type === "password";

            passwordInput.type = isPassword ? "text" : "password";
            icon.classList.toggle("fa-eye");
            icon.classList.toggle("fa-eye-slash");
        }
    </script>


</body>
</html>