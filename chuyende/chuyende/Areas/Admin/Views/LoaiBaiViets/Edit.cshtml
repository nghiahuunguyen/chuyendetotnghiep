@model chuyende.Models.LoaiBaiViet

@{
    ViewBag.Title = "Chỉnh sửa thông tin loại bài viết";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<h3>Chỉnh sửa thông tin loại bài viết</h3>

@using (Html.BeginForm("Edit", "LoaiBaiViets", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.MaLoaiBV)

    <div class="form-group">
        @Html.LabelFor(model => model.TenLoaiBV, "Tên loại bài viết", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.TenLoaiBV, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.TenLoaiBV, "", new { @class = "text-danger" })
        </div>
    </div>


    <div class="form-actions">
        <button type="submit" class="save-btn btn btn-success">Lưu & thay đổi</button>
        <button type="button" class="cancel-btn btn btn-secondary" onclick="window.location.href='@Url.Action("Index", "LoaiBaiViets")'">Hủy</button>
    </div>
}
