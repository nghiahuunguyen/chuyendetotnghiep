@model chuyende.Models.LoaiBaiViet

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="table-container">
    <h3>Bạn có chắc chắn muốn xóa mục này không?</h3>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Tên loại bài viết</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@Html.DisplayFor(model => model.TenLoaiBV)</td>
            </tr>
        </tbody>
    </table>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.MaLoaiBV) <!-- Đảm bảo truyền ID để xóa -->

        <div class="form-actions">
            <button type="submit" class="delete">Xác nhận</button>
            <button type="button" class="cancel-btn btn btn-secondary"
                    onclick="window.location.href='@Url.Action("Index", "LoaiBaiViets")'">
                Hủy
            </button>
        </div>
    }
</div>
