@model List<chuyende.Models.LoaiBaiViet>

@{
    ViewBag.Title = "Thùng rác";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="table-container">
    <h3>Thùng rác loại bài viết</h3>

    <div class="form-actions d-flex justify-content-end gap-2 mb-3">
        @using (Html.BeginForm("RestoreAll", "LoaiBaiViets", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary btn-sm">
                <i class="fas fa-recycle"></i> Khôi phục tất cả
            </button>
        }

        @using (Html.BeginForm("DeleteAllForever", "LoaiBaiViets", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger btn-sm">
                <i class="fas fa-trash"></i> Xóa tất cả vĩnh viễn
            </button>
        }
    </div>

    <table class="table table-bordered table-striped align-middle">
        <thead>
            <tr>
                <th>Tên loại bài viết</th>
                <th>Chức năng</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.TenLoaiBV</td>
                        <td>
                            <div class="d-flex gap-2">
                                @using (Html.BeginForm("Restore", "LoaiBaiViets", new { id = item.MaLoaiBV }, FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-success btn-sm">
                                        <i class="fas fa-undo"></i> Khôi phục
                                    </button>
                                }

                                @using (Html.BeginForm("DeleteForever", "LoaiBaiViets", new { id = item.MaLoaiBV }, FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash-alt"></i> Xóa vĩnh viễn
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="form-actions">
        <button type="button" class="cancel-btn btn btn-secondary" onclick="window.location.href='@Url.Action("Index", "LoaiBaiViets")'">Hủy</button>
    </div>
</div>
