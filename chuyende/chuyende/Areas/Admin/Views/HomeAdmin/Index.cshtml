@model chuyende.Models.ThongKeAdmin
@{
    ViewBag.Title = "Trang chủ admin";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    /* Center the content vertically and horizontally */
    .center-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: calc(100vh - 150px); /* Adjust based on header/footer */
        padding: 20px;
    }

    /* Ensure cards are evenly spaced and responsive */
    .row {
        max-width: 1200px;
        margin: 0 auto;
    }

    /* Make cards uniform in size */
    .card {
        border-radius: 10px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        height: 150px; /* Fixed height for all cards */
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
        }

    /* Ensure card-body takes full height and centers content */
    .card-body {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        width: 100%;
        height: 100%;
        padding: 15px;
    }

    /* Improve typography and icon alignment */
    .card-title {
        font-size: 1.1rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 10px;
        line-height: 1.2;
    }

    .card-text {
        font-size: 2.2rem;
        font-weight: bold;
        margin: 0;
    }

    /* Add spacing between cards */
    .col-md-3 {
        margin-bottom: 20px;
    }
</style>
<div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-box success" id="success-alert">
            <span class="icon">✔</span>
            <span>@TempData["SuccessMessage"]</span>
            <button class="close-btn" onclick="this.parentElement.style.display='none';">×</button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-box error" id="error-alert">
            <span class="icon">✖</span>
            <span>@TempData["ErrorMessage"]</span>
            <button class="close-btn" onclick="this.parentElement.style.display='none';">×</button>
        </div>
    }

</div>
<div class="center-container">
    <div class="row">
        <!-- Đơn chờ xử lý -->
        <div class="col-md-3">
            <div class="card text-white bg-warning mb-3 text-center shadow-sm">
                <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-clock me-2"></i>Đơn chờ xử lý</h5>
                    <p class="card-text">@Model.DonHangChoXuLy</p>
                </div>
            </div>
        </div>

        <!-- Đơn đang vận chuyển -->
        <div class="col-md-3">
            <div class="card text-white bg-info mb-3 text-center shadow-sm">
                <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-shipping-fast me-2"></i>Đơn đang vận chuyển</h5>
                    <p class="card-text">@Model.DonHangDangVanChuyen</p>
                </div>
            </div>
        </div>

        <!-- Đơn đã hoàn thành -->
        <div class="col-md-3">
            <div class="card text-white bg-success mb-3 text-center shadow-sm">
                <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-check-circle me-2"></i>Đơn đã hoàn thành</h5>
                    <p class="card-text">@Model.DonHangDaHoanThanh</p>
                </div>
            </div>
        </div>

        <!-- Liên hệ chưa xem -->
        <div class="col-md-3">
            <div class="card text-white bg-danger mb-3 text-center shadow-sm">
                <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-envelope me-2"></i>Liên hệ chưa xem</h5>
                    <p class="card-text">@Model.LienHeChuaXem</p>
                </div>
            </div>
        </div>
    </div>
</div>