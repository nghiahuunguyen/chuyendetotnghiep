@model IEnumerable<chuyende.Models.HoaDon>
@{
    ViewBag.Title = "Hóa Đơn";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="table-container">
    <h3>Danh sách hóa đơn</h3>

    <div class="actions">
        <a href="@Url.Action("Create", "HoaDons")" class="add-btn">
            <i class="fas fa-plus"></i> Thêm mới
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover">
            <tr>
                <th>#</th>
                <th>Tên khách hàng</th>
                <th>Địa chỉ</th>
                <th>Số điện thoại</th>
                <th>Email</th>
                <th>Tổng tiền</th>
                <th>Chức năng</th>
            </tr>
            <tbody>
                @{ int stt = 1; }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@stt</td>
                        <td>@Html.DisplayFor(modelItem => item.TenKH)</td>
                        <td>@Html.DisplayFor(modelItem => item.DiaChi)</td>
                        <td>@Html.DisplayFor(modelItem => item.SoDienThoai)</td>
                        <td>@Html.DisplayFor(modelItem => item.Email)</td>
                        <td>
                            @* Hiển thị tổng tiền từ ViewBag.TongTienList *@
                            @String.Format("{0:C0}", ViewBag.TongTienList[stt - 1])
                        </td>
                        <td class="text-start">
                            <a href="@Url.Action("Details", "ChucVus", new { id = item.MaHD })" class="btn btn-info btn-sm">
                                <i class="fas fa-eye"></i>
                            </a>
                        </td>
                    </tr>
                    stt++;
                }
            </tbody>
        </table>
    </div>
</div>
