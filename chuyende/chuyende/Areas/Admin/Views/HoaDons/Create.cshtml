@model chuyende.Models.HoaDon

@{
    ViewBag.Title = "Tạo hóa đơn";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

    var jsonData = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.SanPhamData ?? new List<object>());
    var paymentMethods = new List<SelectListItem>
    {
        new SelectListItem { Value = "1", Text = "Tiền mặt" },
        new SelectListItem { Value = "2", Text = "Chuyển khoản" }
    };
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-box error" id="error-alert">
        <span class="icon">✖</span>
        <span>@TempData["ErrorMessage"]</span>
        <button class="close-btn" onclick="this.parentElement.style.display='none';">×</button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-box success" id="success-alert">
        <span class="icon">✔</span>
        <span>@TempData["SuccessMessage"]</span>
        <button class="close-btn" onclick="this.parentElement.style.display='none';">×</button>
    </div>
}

@using (Html.BeginForm("Create", "HoaDons", FormMethod.Post, new { @id = "createForm" }))
{
    @Html.AntiForgeryToken()

    <div class="main-content">
        <div class="form-container">
            <div class="customer-info">
                <h3>Thông tin khách hàng</h3>

                <div class="form-group">
                    @Html.LabelFor(m => m.TenKH, "Tên Khách Hàng")
                    @Html.TextBoxFor(m => m.TenKH, new { @placeholder = "Nhập họ và tên", @class = "form-control", @id = "TenKH" })
                    @Html.ValidationMessageFor(m => m.TenKH, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.DiaChi, "Địa Chỉ")
                    @Html.TextBoxFor(m => m.DiaChi, new { @placeholder = "Nhập địa chỉ", @class = "form-control", @id = "DiaChi" })
                    @Html.ValidationMessageFor(m => m.DiaChi, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Email, "Email")
                    @Html.TextBoxFor(m => m.Email, new { @placeholder = "Nhập email", @class = "form-control", @id = "Email" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.SoDienThoai, "Số Điện Thoại")
                    @Html.TextBoxFor(m => m.SoDienThoai, new { @placeholder = "Nhập số điện thoại", @class = "form-control", @id = "SoDienThoai" })
                    @Html.ValidationMessageFor(m => m.SoDienThoai, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="order-info">
                <h3>Thông tin đơn hàng</h3>
                <div class="table-container">
                    <table id="orderTable">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Số lượng</th>
                                <th>Đơn giá</th>
                                <th>Thành tiền</th>
                                <th>Hành động</th>
                            </tr>
                        </thead>
                        <tbody id="orderProducts"></tbody>
                    </table>
                </div>

                <button class="add-product-btn" type="button" data-bs-toggle="modal" data-bs-target="#addProductModal">+ Thêm sản phẩm</button>

                <div class="form-group">
                    @Html.Label("Tổng tiền")
                    @Html.TextBox("TotalPrice", "", new { @class = "form-control", @readonly = "readonly" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.PhuongThucThanhToan, "Phương thức thanh toán")
                    @Html.DropDownListFor(m => m.PhuongThucThanhToan, paymentMethods, "-- Chọn phương thức --", new { @class = "form-control" })
                    <div id="qr-container" style="margin-top: 15px; display: none;"></div>
                </div>

                <button class="payment-btn" type="submit">Thanh toán</button>
            </div>
        </div>
    </div>

    <!-- Modal thêm sản phẩm -->
    <div class="modal fade" id="addProductModal" tabindex="-1" aria-labelledby="addProductModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addProductModalLabel">Thêm Sản Phẩm</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label for="productSelect">Sản phẩm</label>
                        @if (ViewBag.SanPhams != null && ViewBag.SanPhams is List<SelectListItem>)
                        {
                            var sanPhamData = ViewBag.SanPhamData as List<dynamic> ?? new List<dynamic>();
                            <select class="form-control" id="productSelect" name="productSelect">
                                <option value="">Tìm kiếm sản phẩm...</option>
                                @foreach (var sp in ViewBag.SanPhams as List<SelectListItem>)
                                {
                                    <option value="@sp.Value" data-price="@(sanPhamData.FirstOrDefault(p => p.MaSP == sp.Value)?.GiaBan ?? 0)">@sp.Text</option>
                                }
                            </select>
                        }
                        else
                        {
                            <p>Không có sản phẩm nào để hiển thị.</p>
                        }
                    </div>
                    <div class="form-group">
                        <label for="quantityInput">Số lượng</label>
                        <input type="number" class="form-control" id="quantityInput" value="1" min="1">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-primary" id="addProductConfirm">Thêm</button>
                </div>
            </div>
        </div>
    </div>
    <div class="form-actions">
        <button type="button" class="cancel-btn btn btn-secondary" onclick="window.location.href='@Url.Action("Index", "HoaDons")'">Hủy</button>
    </div>
}

<!-- Thêm jQuery và Select2 -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
<!-- PayOS SDK -->
<script src="https://cdn.payos.vn/payos-checkout/v1/payos-initialize.js"></script>

<style>
    .main-content {
        overflow-y: auto;
        max-height: 100vh;
        padding-bottom: 20px;
    }

    .form-container {
        display: flex;
        width: 100%;
        background: white;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
        border-radius: 8px;
    }

    .customer-info, .order-info {
        flex: 1;
        padding: 20px;
    }

        .customer-info h3, .order-info h3 {
            margin-bottom: 15px;
            border-bottom: 2px solid #007bff;
            padding-bottom: 10px;
        }

    .form-group {
        margin-top: 10px;
        margin-bottom: 15px;
    }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            color: #333;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            padding: 8px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }

    .select2-container .select2-selection--single {
        height: 38px;
        border: 1px solid #ddd;
        border-radius: 4px;
    }

    .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 38px;
    }

    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 38px;
    }

    .select2-container {
        width: 100% !important;
    }

    .select2-search__field {
        width: 100% !important;
    }

    .modal-backdrop {
        z-index: 1040 !important;
    }

    .modal {
        z-index: 1050 !important;
    }

    #qr-container {
        max-height: 200px;
        overflow-y: auto;
    }
</style>

<script>
    $(document).ready(function () {
        let productData = @Html.Raw(jsonData);
        console.log("productData:", productData);

        // Hàm xóa backdrop và trạng thái modal-open
        function clearModalBackdrop() {
            $('.modal-backdrop').remove();
            $('body').removeClass('modal-open').css('overflow', 'auto');
        }

        // Khởi tạo Select2
        $('#productSelect').select2({
            placeholder: "Tìm kiếm sản phẩm...",
            allowClear: true,
            dropdownParent: $('#addProductModal'),
            width: '100%',
            minimumInputLength: 0
        });

        // Xóa backdrop trước khi mở modal
        $('.add-product-btn').on('click', function () {
            clearModalBackdrop();
        });

        // Reset modal khi mở
        $('#addProductModal').on('shown.bs.modal', function () {
            $('#productSelect').val('').trigger('change');
            $('#quantityInput').val(1);
        });

        // Đóng dropdown Select2 và xóa backdrop khi đóng modal
        $('#addProductModal').on('hide.bs.modal', function () {
            $('#productSelect').select2('close');
            clearModalBackdrop();
        });

        // Đóng modal hoàn toàn khi ẩn
        $('#addProductModal').on('hidden.bs.modal', function () {
            clearModalBackdrop();
        });

        // Định dạng tiền tệ
        function formatCurrency(value) {
            return value.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' });
        }

        // Cập nhật tổng tiền
        function updateTotalPrice() {
            try {
                let total = 0;
                $('#orderProducts tr').each(function () {
                    let thanhTien = parseFloat($(this).find('.thanh-tien').data('value')) || 0;
                    total += thanhTien;
                });
                $('#TotalPrice').val(formatCurrency(total));
                return total;
            } catch (error) {
                console.log("Error in updateTotalPrice:", error);
                $('#TotalPrice').val('0 đ');
                return 0;
            }
        }

        // Thêm sản phẩm
        $('#addProductConfirm').click(function () {
            try {
                console.log("addProductConfirm started");
                let productId = $('#productSelect').val();
                let quantity = parseInt($('#quantityInput').val());

                if (!productId || quantity <= 0) {
                    alert("Vui lòng chọn sản phẩm và số lượng hợp lệ.");
                    return;
                }

                let selectedProduct = productData.find(p => p.MaSP === productId);
                if (!selectedProduct) {
                    alert("Không tìm thấy sản phẩm.");
                    return;
                }

                let price = parseFloat(selectedProduct.GiaBan) || 0;
                if (isNaN(price)) {
                    console.log("GiaBan không hợp lệ:", selectedProduct.GiaBan);
                    price = 0;
                }

                let total = price * quantity;

                let newRow = `
                    <tr>
                        <td>
                            <input type="hidden" name="MaSPs" value="${productId}" />
                            ${selectedProduct.TenSP}
                        </td>
                        <td>
                            <input type="hidden" name="SoLuongs" value="${quantity}" />
                            ${quantity}
                        </td>
                        <td>${formatCurrency(price)}</td>
                        <td class="thanh-tien" data-value="${total}">${formatCurrency(total)}</td>
                        <td><button type="button" class="btn btn-danger btn-sm remove-product">Xóa</button></td>
                    </tr>
                `;

                $('#orderProducts').append(newRow);
                $('#productSelect').select2('close');
                $('#addProductModal').modal('hide');
                clearModalBackdrop();
                updateTotalPrice();
            } catch (error) {
                console.log("Error in addProductConfirm:", error);
                $('#addProductModal').modal('hide');
                clearModalBackdrop();
            }
        });

        // Xóa sản phẩm
        $('#orderProducts').on('click', '.remove-product', function () {
            try {
                $(this).closest('tr').remove();
                updateTotalPrice();
            } catch (error) {
                console.log("Error in remove-product:", error);
            }
        });

        // Tự động điền thông tin khách hàng
        $("#SoDienThoai").on("blur", function () {
            console.log("SoDienThoai blur triggered");
            var soDienThoai = $(this).val();
            var email = $("#Email").val();
            if (soDienThoai) {
                fetchCustomerInfo(soDienThoai, email);
            }
        });

        $("#Email").on("blur", function () {
            console.log("Email blur triggered");
            var email = $(this).val();
            var soDienThoai = $("#SoDienThoai").val();
            if (email) {
                fetchCustomerInfo(soDienThoai, email);
            }
        });

        function fetchCustomerInfo(soDienThoai, email) {
            console.log("Fetching customer info:", soDienThoai, email);
            $.ajax({
                url: '@Url.Action("GetCustomerInfo", "HoaDons")',
                type: 'POST',
                data: { soDienThoai: soDienThoai, email: email },
                success: function (response) {
                    console.log("Response:", response);
                    if (response.success) {
                        $("#TenKH").val(response.data.TenKH);
                        $("#SoDienThoai").val(response.data.SoDienThoai);
                        $("#Email").val(response.data.Email);
                        $("#DiaChi").val(response.data.DiaChi);
                    }
                },
                error: function (xhr, status, error) {
                    console.log("Lỗi khi tìm thông tin khách hàng:", error, xhr.status);
                }
            });
        }

        // Xử lý phương thức thanh toán
        function parseCurrencyToNumber(currencyStr) {
            return Number(currencyStr.replace(/[^\d]/g, ""));
        }

        function generateQR(amount, tenKH, soDienThoai, email, diaChi, items) {
            console.log("generateQR called with:", { amount, tenKH, soDienThoai, email, diaChi, items });
            $.ajax({
                url: '@Url.Action("InitiatePayment", "HoaDons")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    amount: amount,
                    tenKH: tenKH,
                    soDienThoai: soDienThoai,
                    email: email,
                    diaChi: diaChi,
                    itemsJson: JSON.stringify(items)
                }),
                success: function (response) {
                    console.log("InitiatePayment response:", response);
                    if (response && typeof response === 'object' && 'success' in response) {
                        if (response.success) {
                            const checkout_url = response.checkoutUrl;
                            if (!checkout_url) {
                                console.error("Checkout URL is missing in response:", response);
                                $('#qr-container').hide();
                                alert("Không thể tạo QR code: Checkout URL không tồn tại.");
                                return;
                            }
                            const payOSConfig = {
                                RETURN_URL: '@Url.Action("PaymentSuccess", "HoaDons", new { area = "Admin" }, Request.Url.Scheme)',
                                ELEMENT_ID: "qr-container",
                                CHECKOUT_URL: checkout_url,
                                embedded: true,
                                onSuccess: function (event) {
                                    console.log("Payment successful:", event);
                                    $('#qr-container').hide();
                                    // Tự động gọi confirmPayment sau khi thanh toán thành công
                                    confirmPayment();
                                },
                                onCancel: function (event) {
                                    console.log("Payment canceled:", event);
                                    $('#qr-container').hide();
                                    alert("Thanh toán đã bị hủy.");
                                },
                                onExit: function (event) {
                                    console.log("Payment exited:", event);
                                    $('#qr-container').hide();
                                    alert("Bạn đã thoát khỏi thanh toán.");
                                }
                            };

                            try {
                                const { open, exit } = PayOSCheckout.usePayOS(payOSConfig);
                                console.log("Opening PayOS checkout...");
                                open();
                            } catch (error) {
                                console.error("Error initializing PayOS checkout:", error);
                                $('#qr-container').hide();
                                alert("Lỗi khi khởi tạo QR code: " + error.message);
                            }
                        } else {
                            console.error("InitiatePayment failed:", response.message);
                            $('#qr-container').hide();
                            alert("Không thể tạo yêu cầu thanh toán: " + (response.message || "Lỗi không xác định"));
                        }
                    } else {
                        console.error("Invalid response format:", response);
                        $('#qr-container').hide();
                        alert("Định dạng phản hồi từ server không đúng: " + JSON.stringify(response));
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Lỗi khi gọi InitiatePayment:", error, xhr.status, xhr.responseText);
                    $('#qr-container').hide();
                    alert("Đã xảy ra lỗi khi tạo yêu cầu thanh toán: " + (xhr.responseText || error));
                }
            });
        }

        function confirmPayment() {
            console.log("confirmPayment called");
            $.ajax({
                url: '@Url.Action("ConfirmPayment", "HoaDons")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({}),
                success: function (response) {
                    console.log("ConfirmPayment response:", response);
                    if (response && typeof response === 'object' && 'success' in response) {
                        if (response.success) {
                            alert("Hóa đơn đã được lưu thành công!");
                            window.location.href = '@Url.Action("Index", "HoaDons", new { area = "Admin" })';
                        } else {
                            console.error("ConfirmPayment failed:", response.message);
                            alert("Lỗi khi lưu hóa đơn: " + (response.message || "Lỗi không xác định"));
                        }
                    } else {
                        console.error("Invalid response format from ConfirmPayment:", response);
                        alert("Định dạng phản hồi từ server không đúng: " + JSON.stringify(response));
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Lỗi khi xác nhận thanh toán:", error, xhr.status, xhr.responseText);
                    alert("Đã xảy ra lỗi khi lưu hóa đơn: " + (xhr.responseText || error));
                }
            });
        }

        $('#createForm').submit(function (e) {
            var paymentMethod = $('#PhuongThucThanhToan').val();
            if (paymentMethod === "2") {
                e.preventDefault();
                $('#qr-container').show();
                let totalStr = $('#TotalPrice').val();
                let amount = parseCurrencyToNumber(totalStr);
                let tenKH = $("#TenKH").val();
                let soDienThoai = $("#SoDienThoai").val();
                let email = $("#Email").val();
                let diaChi = $("#DiaChi").val();
                let items = [];
                $('#orderProducts tr').each(function () {
                    let maSP = $(this).find('input[name="MaSPs"]').val();
                    let soLuong = parseInt($(this).find('input[name="SoLuongs"]').val());
                    items.push({ MaSP: maSP, SoLuong: soLuong });
                });

                if (!tenKH || !soDienThoai || !email || !diaChi || items.length === 0) {
                    alert("Vui lòng nhập đầy đủ thông tin khách hàng và thêm ít nhất một sản phẩm.");
                    $('#qr-container').hide();
                    $('#PhuongThucThanhToan').val('');
                    return;
                }

                generateQR(amount, tenKH, soDienThoai, email, diaChi, items);
                $('body').removeClass('modal-open').css('overflow', 'auto');
            }
        });

        $('#PhuongThucThanhToan').change(function () {
            try {
                let selectedValue = $(this).val();
                if (selectedValue === "2") {
                    $('#qr-container').show();
                } else {
                    $('#qr-container').hide();
                    $('body').removeClass('modal-open').css('overflow', 'auto');
                }
            } catch (error) {
                console.log("Error in PhuongThucThanhToan change:", error);
                $('#qr-container').hide();
            }
        });

        // Đảm bảo trang có thể cuộn khi khởi tạo
        $(window).on('load', function () {
            clearModalBackdrop();
        });
    });
</script>