@model chuyende.Models.HoaDon

@{
    ViewBag.Title = "Tạo hóa đơn";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

    // Serialize dữ liệu cho JavaScript
    var jsonData = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.SanPhamData);
}


@if (!ViewData.ModelState.IsValid)
{
    <div style="color:red;">
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="main-content">
        <div class="form-container">
            <div class="customer-info">
                <h3>Thông tin khách hàng</h3>

                <div class="form-group">
                    @Html.LabelFor(m => m.TenKH, "Tên Khách Hàng")
                    @Html.TextBoxFor(m => m.TenKH, new { @placeholder = "Nhập họ và tên", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.TenKH, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.DiaChi, "Địa Chỉ")
                    @Html.TextBoxFor(m => m.DiaChi, new { @placeholder = "Nhập địa chỉ", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.DiaChi, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Email, "Email")
                    @Html.TextBoxFor(m => m.Email, new { @placeholder = "Nhập email", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.SoDienThoai, "Số Điện Thoại")
                    @Html.TextBoxFor(m => m.SoDienThoai, new { @placeholder = "Nhập số điện thoại", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.SoDienThoai, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="order-info">
                <h3>Thông tin đơn hàng</h3>
                <div class="table-container">
                    <table id="orderTable">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Số lượng</th>
                                <th>Đơn giá</th>
                                <th>Thành tiền</th>
                                <th>Hành động</th>
                            </tr>
                        </thead>
                        <tbody id="orderProducts">
                            <!-- Các sản phẩm sẽ được thêm qua JavaScript -->
                        </tbody>
                    </table>
                </div>

                <button class="add-product-btn" type="button" data-bs-toggle="modal" data-bs-target="#addProductModal">+ Thêm sản phẩm</button>

                <div class="form-group">
                    @Html.Label("Tổng tiền")
                    @Html.TextBox("TotalPrice", "", new { @class = "form-control", @readonly = "readonly" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.PhuongThucThanhToan, "Phương thức thanh toán")
                    @Html.DropDownListFor(m => m.PhuongThucThanhToan, new SelectList(new[] {
                        new { Value = 1, Text = "Tiền mặt" },
                        new { Value = 2, Text = "Chuyển khoản" }
                    }, "Value", "Text"), new { @class = "form-control" })
                </div>

                <button class="payment-btn" type="submit">Thanh toán</button>
            </div>
        </div>
    </div>

    <!-- Bootstrap Modal -->
    <div class="modal fade" id="addProductModal" tabindex="-1" aria-labelledby="addProductModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addProductModalLabel">Thêm Sản Phẩm</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>Sản phẩm</label>
                        <select class="form-control" id="productSelect">
                            @foreach (var sp in ViewBag.SanPhams as List<SelectListItem>)
                            {
                                <option value="@sp.Value">@sp.Text</option>
                            }
                        </select>

                    </div>
                    <div class="form-group">
                        <label>Số lượng</label>
                        <input type="number" class="form-control" id="quantityInput" value="1" min="1">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-primary" id="addProductConfirm">Thêm</button>
                </div>
            </div>
        </div>
    </div>
    <div class="form-actions">
        <button type="button" class="cancel-btn btn btn-secondary" onclick="window.location.href='@Url.Action("Index", "HoaDons")'">Hủy</button>

    </div>
}

<!-- Thêm jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Thêm Select2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<!-- Thêm Select2 JS -->
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<style>
    .form-container {
        display: flex;
        width: 100%;
        background: white;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
        border-radius: 8px;
    }

    .customer-info, .order-info {
        flex: 1;
        padding: 20px;
    }

        .customer-info h3, .order-info h3 {
            margin-bottom: 15px;
            border-bottom: 2px solid #007bff;
            padding-bottom: 10px;
        }

    .form-group {
        margin-top: 10px;
        margin-bottom: 15px;
    }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            color: #333;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            padding: 8px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }
</style>
<script>
    $(document).ready(function () {
        let productData = @Html.Raw(jsonData);

        // Initialize Select2
        $('#productSelect').select2({
            placeholder: "Chọn sản phẩm",
            allowClear: true,
            dropdownParent: $('#addProductModal')
        });

        $('#addProductModal').on('shown.bs.modal', function () {
            $('#productSelect').val(null).trigger('change');
            $('#quantityInput').val(1);
        });

        function formatCurrency(value) {
            return value.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' });
        }

        function updateTotalPrice() {
            let total = 0;
            $('#orderProducts tr').each(function () {
                let thanhTien = parseFloat($(this).find('.thanh-tien').data('value'));
                total += thanhTien;
            });
            $('#TotalPrice').val(formatCurrency(total));
        }

        $('#addProductConfirm').click(function () {
            let productId = $('#productSelect').val();
            let quantity = parseInt($('#quantityInput').val());

            if (!productId || quantity <= 0) {
                alert("Vui lòng chọn sản phẩm và số lượng hợp lệ.");
                return;
            }

            let selectedProduct = productData.find(p => p.MaSP == productId);
            if (!selectedProduct) {
                alert("Không tìm thấy sản phẩm.");
                return;
            }

            let price = selectedProduct.Gia;
            let total = price * quantity;

            let newRow = `
                <tr>
                    <td>
                        <input type="hidden" name="MaSPs" value="${productId}" />
                        ${selectedProduct.TenSP}
                    </td>
                    <td>
                        <input type="hidden" name="SoLuongs" value="${quantity}" />
                        ${quantity}
                    </td>
                    <td>${formatCurrency(price)}</td>
                    <td class="thanh-tien" data-value="${total}">${formatCurrency(total)}</td>
                    <td><button type="button" class="btn btn-danger btn-sm remove-product">Xóa</button></td>
                </tr>
            `;

            $('#orderProducts').append(newRow);
            $('#addProductModal').modal('hide');
            updateTotalPrice();
        });

        $('#orderProducts').on('click', '.remove-product', function () {
            $(this).closest('tr').remove();
            updateTotalPrice();
        });
    });
</script>

