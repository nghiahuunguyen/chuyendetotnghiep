@model chuyende.Models.HoaDon
@{
    ViewBag.Title = "Chi tiết hóa đơn";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var chiTietList = ViewBag.ChiTietList as List<dynamic>; // Cast ViewBag thành List<dynamic>
    decimal tongTien = ViewBag.TongTien ?? 0;

    // Kiểm tra nếu chiTietList là null hoặc rỗng
    if (chiTietList == null || !chiTietList.Any())
    {
        chiTietList = new List<dynamic>(); // Khởi tạo một danh sách trống nếu không có chi tiết
    }
}

<div class="main-content">
    <div class="form-container">
        <div class="customer-info">
            <h3>Thông tin khách hàng</h3>

            <div class="form-group">
                <label>Họ và tên</label>
                <span class="form-control">@Model.TenKH</span>
            </div>

            <div class="form-group">
                <label>Địa chỉ</label>
                <span class="form-control">@Model.DiaChi</span>
            </div>
            <div class="form-group">
                <label>Email</label>
                <span class="form-control">@Model.Email</span>
            </div>
            <div class="form-group">
                <label>Số điện thoại</label>
                <span class="form-control">@Model.SoDienThoai</span>
            </div>
            <div class="form-group">
                <label>Ngày mua</label>
                <span class="form-control">@String.Format("{0:dd/MM/yyyy}", Model.NgayTao)</span>
            </div>
            <div class="form-group">
                <label>Người tạo hóa đơn</label>
                <span class="form-control">@Model.NguoiTao</span>
            </div>


        </div>

        <div class="order-info">
            <h3>Thông tin đơn hàng</h3>
            <div>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Số lượng</th>
                            <th>Đơn giá</th>
                            <th>Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (dynamic ct in ViewBag.ChiTietList)
                        {
                            <tr>
                                <td>@ct.TenSP</td> <!-- Hiển thị tên sản phẩm -->
                                <td>@ct.SoLuong</td> <!-- Hiển thị số lượng -->
                                <td>@string.Format("{0:N0} đ", ct.DonGia)</td> <!-- Hiển thị đơn giá -->
                                <td>@string.Format("{0:N0} đ", ct.ThanhTien)</td> <!-- Hiển thị thành tiền -->
                            </tr>
                        }
                    </tbody>
                </table>

            </div>

            <div class="form-group">
                <label>Tổng tiền</label>
                <span class="form-control">@string.Format("{0:N0} đ", tongTien)</span>
            </div>
            <div class="form-group">
                <label>Hình thức thanh toán</label>
                @if (Model.PhuongThucThanhToan == 1)
                {
                    <span class="form-control">Tiền mặt</span>
                }
                else if (Model.PhuongThucThanhToan == 2)
                {
                    <span class="form-control">Chuyển khoản</span>
                }
                else
                {
                    <span class="form-control">Không xác định</span>
                }
            </div>
            <div class="form-group">
                <label>Trạng thái</label>
                @{
                    string statusText;
                    string statusColor;

                    switch (Model.TrangThai)
                    {
                        case 0:
                            statusText = "Đã thanh toán";
                            statusColor = "green";
                            break;
                        case 1:
                            statusText = "Đang xử lý";
                            statusColor = "red";
                            break;
                        case 2:
                            statusText = "Đang vận chuyển";
                            statusColor = "red";
                            break;
                        case 3:
                            statusText = "Đã giao và thanh toán";
                            statusColor = "green";
                            break;
                        default:
                            statusText = "Không xác định";
                            statusColor = "black";
                            break;
                    }
                }
                <span class="form-control" style="color:@statusColor">@statusText</span>
            </div>


        </div>

    </div>
    <div class="form-actions">
        <button type="button" class="cancel-btn btn btn-secondary" onclick="window.location.href='@Url.Action("Index", "HoaDons")'">Hủy</button>

    </div>
</div>