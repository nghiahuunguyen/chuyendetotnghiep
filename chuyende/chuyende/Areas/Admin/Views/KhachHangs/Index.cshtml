@model IEnumerable<chuyende.Models.KhachHangViewModel>
@{
    ViewBag.Title = "Danh sách khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="table-container">
    <h3>Danh sách khách hàng</h3>
    <table >
        <thead>
            <tr>
                <th>Tên khách hàng</th>
                <th>Email</th>
                <th>Số điện thoại</th>
                <th>Địa chỉ</th>
                <th>Số lần mua</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var kh in Model)
            {
                <tr>
                    <td>@kh.TenKH</td>
                    <td>@kh.Email</td>
                    <td>@kh.SoDienThoai</td>
                    <td>@kh.DiaChi</td>
                    <td>@kh.SoLanMua</td> <!-- Hiển thị số lần mua -->
                </tr>
            }
        </tbody>
    </table>
</div>
    
