@model PagedList.IPagedList<chuyende.Models.BaiViet>
@using PagedList.Mvc

@{
    ViewBag.Title = "Danh sách bài viết";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="table-container">
    <h3>Danh sách bài viết</h3>
    <div>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert-box success" id="success-alert">
                <span class="icon">✔</span>
                <span>@TempData["SuccessMessage"]</span>
                <button class="close-btn" onclick="this.parentElement.style.display='none';">×</button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert-box error" id="error-alert">
                <span class="icon">✖</span>
                <span>@TempData["ErrorMessage"]</span>
                <button class="close-btn" onclick="this.parentElement.style.display='none';">×</button>
            </div>
        }

    </div>

    <div class="actions">
        <a href="@Url.Action("Create", "BaiViets")" class="add-btn">
            <i class="fas fa-plus"></i> Thêm mới
        </a>
        <a href="@Url.Action("Trash", "BaiViets")" class="trash-btn">
            <i class="fas fa-trash"></i> Thùng rác
        </a>

    </div>


    <div class="table-responsive">
        <table class="table table-bordered table-hover">
            <tr>
                <th>#</th>
                <th>Mã bài viết</th>
                <th>Tên bài viết</th>
                <th>Hình ảnh</th>
                <th>Loại bài viết</th>
                <th>Chức năng</th>
            </tr>
            <tbody>
                @{ int stt = 1; }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@stt</td>
                        <td>@Html.DisplayFor(modelItem => item.MaBV)</td>
                        <td>@Html.DisplayFor(modelItem => item.TenBV)</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.HinhAnh))
                            {
                                <img src="@Url.Content("~/img/baiviet/" + item.HinhAnh)" alt="Hình ảnh" class="img-thumbnail" style="max-width: 100px; max-height: 100px;" />
                            }
                            else
                            {
                                <span>Không có hình ảnh</span>
                            }
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.LoaiBaiViet.TenLoaiBV)</td>
                        <td class="text-start">
                            <button class="btn status-toggle @(item.Status == 1 ? "btn-success" : "btn-danger")"
                                    data-id="@item.MaBV">
                                <i class="fa @(item.Status == 1 ? "fa-toggle-on" : "fa-toggle-off")"></i>
                            </button>
                            <a href="@Url.Action("Edit","BaiViets", new { id = item.MaBV })" class="btn btn-warning btn-sm">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a href="@Url.Action("Details","BaiViets", new { id = item.MaBV })" class="btn btn-info btn-sm">
                                <i class="fas fa-eye"></i>
                            </a>
                            @using (Html.BeginForm("MoveToTrash", "BaiViets", new { id = item.MaBV }, FormMethod.Post, new { @class = "d-inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash"></i>
                                </button>
                            }
                        </td>
                    </tr>
                    stt++;
                }
            </tbody>
        </table>
    </div>
    <div class="pagination-container text-end">
        @Html.PagedListPager(Model, page => Url.Action("Index", new { page }),
            new PagedListRenderOptions
            {
                DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                DisplayLinkToLastPage = PagedListDisplayMode.Always,
                DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                DisplayLinkToNextPage = PagedListDisplayMode.Always,
                MaximumPageNumbersToDisplay = 5,
                Display = PagedListDisplayMode.IfNeeded
            })
    </div>

</div>
<script>
    $(document).ready(function () {
    $(".status-toggle").click(function () {
        var button = $(this);
        var id = button.data("id");
        var token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url: '@Url.Action("ToggleStatus", "BaiViets")',
            type: "POST",
            data: { id: id, __RequestVerificationToken: token },
            success: function (response) {
                if (response.success) {
                    if (response.status === 1) {
                        button.removeClass("btn-danger").addClass("btn-success");
                        button.html('<i class="fa fa-toggle-on"></i>');
                    } else {
                        button.removeClass("btn-success").addClass("btn-danger");
                        button.html('<i class="fa fa-toggle-off"></i>');
                    }
                } else {
                    alert("Cập nhật trạng thái thất bại!");
                }
            }
        });
    });
});

</script>