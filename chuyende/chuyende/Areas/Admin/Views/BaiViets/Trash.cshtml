@model IEnumerable<chuyende.Models.BaiViet>

@{
    ViewBag.Title = "Thùng rác bài viết";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="table-container">
    <h3>Thùng rác bài viết</h3>

    <div class="form-actions d-flex justify-content-end gap-2 mb-3">
        @using (Html.BeginForm("RestoreAll", "BaiViets", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary btn-sm">
                <i class="fas fa-recycle"></i> Khôi phục tất cả
            </button>
        }

        @using (Html.BeginForm("DeleteAllForever", "BaiViets", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger btn-sm">
                <i class="fas fa-trash"></i> Xóa tất cả vĩnh viễn
            </button>
        }
    </div>

    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Tên bài viết</th>
                <th>Hình ảnh</th>
                <th>Loại bài viết</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.TenBV</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.HinhAnh))
                        {
                            <img src="@Url.Content("~/img/baiviet/" + item.HinhAnh)" alt="Hình ảnh bài viết" style="max-width: 100px; max-height: 100px;" />
                        }
                        else
                        {
                            <span>Không có hình ảnh</span>
                        }
                    </td>
                    <td>@(item.LoaiBaiViet != null ? item.LoaiBaiViet.TenLoaiBV : "Không xác định")</td>
                    <td>
                        <form action="@Url.Action("Restore", "BaiViets")" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.MaBV" />
                            <button type="submit" class="btn btn-success btn-sm">Khôi phục</button>
                        </form>

                        <form action="@Url.Action("DeleteForever", "BaiViets")" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.MaBV" />
                            <button type="submit" class="btn btn-danger btn-sm">Xóa vĩnh viễn</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="form-actions">
        <button type="button" class="cancel-btn btn btn-secondary"
                onclick="window.location.href='@Url.Action("Index", "BaiViets")'">
            Quay lại danh sách
        </button>
    </div>
</div>
